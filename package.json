{
  "name": "pi-sakura-cyberdeck",
  "version": "1.0.0",
  "description": "Sakura Macaron theme with a cyberdeck header and dynamic Zentui footer for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "tui",
    "sakura"
  ],
  "files": [
    "extensions",
    "themes",
    "licenses",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/header/index.ts",
      "./extensions/zentui/index.ts"
    ],
    "themes": [
      "./themes/sakura-macaron.json"
    ]
  }
}
